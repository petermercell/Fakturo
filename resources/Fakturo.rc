// Fakturo.rc - the Windows resource script.
//
// An .exe carries its icon inside itself rather than beside it, and Explorer
// picks the *numerically lowest* icon resource id as the application icon. So
// this has to be 1, and it has to be first.
//
// The version block is what the file's Properties dialog reads. Windows shows
// nothing at all when it is absent, which looks like a program somebody threw
// together — and the fields are also what an IT department checks before
// letting an unsigned binary run.

#include <windows.h>

1 ICON "Fakturo.ico"

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    FAKTURO_VER_MAJOR,FAKTURO_VER_MINOR,FAKTURO_VER_PATCH,0
  PRODUCTVERSION FAKTURO_VER_MAJOR,FAKTURO_VER_MINOR,FAKTURO_VER_PATCH,0
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_APP
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 040E is Hungarian… 041B is Slovak, and 04B0 is Unicode. The pair
        // has to match the Translation value below or the Properties dialog
        // shows an empty block.
        BLOCK "041B04B0"
        BEGIN
            VALUE "CompanyName",      "studio 202 s. r. o."
            VALUE "FileDescription",  "Fakturo — fakturacny program"
            VALUE "FileVersion",      FAKTURO_VER_STRING
            VALUE "InternalName",     "fakturo"
            VALUE "LegalCopyright",   "Made by Peter Mercell and Claude 2026"
            VALUE "OriginalFilename", "Fakturo.exe"
            VALUE "ProductName",      "Fakturo"
            VALUE "ProductVersion",   FAKTURO_VER_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x41B, 1200
    END
END
